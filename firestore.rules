rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Users
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // Conversations
    match /conversations/{convId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      match /messages/{msgId} {
        allow read: if isAuthenticated()
          && get(/databases/$(database)/documents/conversations/$(convId)).data.userId == request.auth.uid;
        allow create: if isAuthenticated()
          && get(/databases/$(database)/documents/conversations/$(convId)).data.userId == request.auth.uid;
      }
    }

    // Legal documents
    match /documents/{docId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Laws — public read (laws are public domain)
    match /laws/{lawSlug} {
      allow read: if true;
      allow write: if isAdmin();

      match /sections/{sectionId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Guides — public read, admin write
    match /guides/{guideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Templates — public read, admin write
    match /templates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Dictionary — public read, admin write
    match /dictionaryEntries/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Quizzes — public read, admin write
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isAdmin();

      match /questions/{questionId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    // Quiz attempts — user-owned
    match /users/{userId}/quizAttempts/{attemptId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
    }

    // Lawyer profiles — public read for marketplace
    match /lawyerProfiles/{profileId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Consultation requests
    match /consultationRequests/{reqId} {
      allow read: if isAuthenticated()
        && (resource.data.citizenId == request.auth.uid || resource.data.lawyerId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.citizenId == request.auth.uid;
      allow update: if isAuthenticated()
        && (resource.data.citizenId == request.auth.uid || resource.data.lawyerId == request.auth.uid);
    }

    // Subscriptions
    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }

    // Metadata (law categories, stats, etc.)
    match /meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
