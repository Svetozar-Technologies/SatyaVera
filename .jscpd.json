{
  "threshold": 1.5,
  "reporters": ["console", "html"],
  "absolute": true,
  "gitignore": true,
  "format": ["javascript", "jsx", "typescript", "tsx"],
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/out/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "data/**",
    "docs/case-studies/**",
    "scripts/seed-*.ts"
  ],
  "minLines": 8,
  "minTokens": 70
}
