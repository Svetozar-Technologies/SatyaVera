# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/js/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (now lives under /js/, but keep root globs for tooling that
# accidentally drops them at the workspace root)
/.next/
/out/
/js/.next/
/js/out/
/js/build/
/js/dist/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase
.firebase/
firestore-debug.log
firebase-debug.log
ui-debug.log

# rust
/rust/target/
**/*.rs.bk

# static-export build helper
.static-export-stash/
/js/.static-export-stash/
